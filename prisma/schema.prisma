generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-store Architecture
model Store {
  id        String   @id @default(uuid())
  name      String
  address   String
  city      String   @default("Pitalito")
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  inventory Inventory[]
  invoices  Invoice[]
  users     User[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hashed
  role      Role     @default(STAFF)
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

// Product Catalog (Global across all stores)
model Product {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  description String?
  category    String?
  price       Decimal  @db.Decimal(10, 2)
  cost        Decimal  @db.Decimal(10, 2)
  taxRate     Decimal  @default(19.00) // IVA
  barcode     String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  inventory   Inventory[]
  invoiceItems InvoiceItem[]
}

// Inventory per Store
model Inventory {
  id        String   @id @default(uuid())
  storeId   String
  productId String
  quantity  Int      @default(0)
  minStock  Int      @default(5)
  updatedAt DateTime @updatedAt

  store     Store    @relation(fields: [storeId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([storeId, productId])
}

// Sales & Billing (Electronic Invoicing Ready)
model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique // Consecutivo DIAN
  storeId         String
  customerId      String?
  total           Decimal       @db.Decimal(12, 2)
  subtotal        Decimal       @db.Decimal(12, 2)
  taxTotal        Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(DRAFT)
  paymentMethod   PaymentMethod @default(CASH)
  
  // DIAN Specific Fields
  cufe            String?       // Código Único de Factura Electrónica
  qrCode          String?       // URL or Base64
  dianStatus      String?       // 'ACCEPTED', 'REJECTED'
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  store           Store         @relation(fields: [storeId], references: [id])
  customer        Customer?     @relation(fields: [customerId], references: [id])
  items           InvoiceItem[]
}

enum InvoiceStatus {
  DRAFT
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  QR_CODE
}

model InvoiceItem {
  id        String   @id @default(uuid())
  invoiceId String
  productId String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  tax       Decimal  @db.Decimal(10, 2)
  total     Decimal  @db.Decimal(10, 2)

  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Customer {
  id             String    @id @default(uuid())
  name           String
  identification String    @unique // CC or NIT
  idType         String    @default("CC")
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invoices       Invoice[]
}
